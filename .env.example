# Connection string do Postgres (Supabase). Pegue em Project Settings > Database
# > Connection string > URI. Use o "Transaction pooler" (porta 6543) em producao
# serverless (Vercel); em dev local a conexao direta (porta 5432) tambem funciona.
DATABASE_URL=""

# Gere um valor aleatorio. Ex (Linux/Mac): openssl rand -base64 32
# Ou (qualquer SO com Node): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# URL usada para acessar o app. Precisa ser EXATAMENTE o endereco por onde voce
# acessa (o login confere isso).
# - So no PC, sem instalar como app:   http://localhost:3000
# - Como app no PC e nos celulares (https): use o IP fixo da maquina, ex:
#     NEXTAUTH_URL="https://192.168.0.10:3443"
#   (veja docs/INSTALAR-COMO-APP.md - todos os aparelhos usam esse mesmo endereco)
NEXTAUTH_URL="http://localhost:3000"

# Porta do servidor HTTPS (npm run start:https). Padrao 3443.
# HTTPS_PORT="3443"

# Credenciais da Application criada em dashboard.pluggy.ai
# (depois de conectar as contas em meu.pluggy.ai e vincular no Dashboard)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# API key do Resend (resend.com) para os emails de confirmacao de cadastro.
RESEND_API_KEY=""
# Remetente verificado no Resend. Sem dominio proprio use o sandbox:
# EMAIL_FROM="We Finance <onboarding@resend.dev>"
EMAIL_FROM=""

# Allowlist de cadastro (opcional): emails separados por virgula que podem
# criar conta. Vazio/ausente = cadastro aberto a qualquer email.
ALLOWED_SIGNUP_EMAILS=""

# Usuarios iniciais (criados/atualizados pelo "npm run seed").
# Troque nomes, e-mails e senhas antes do primeiro uso.
USER1_NAME="Gabriel"
USER1_EMAIL="gabriel@exemplo.com"
USER1_PASSWORD="mude-esta-senha"

USER2_NAME="Conjuge"
USER2_EMAIL="conjuge@exemplo.com"
USER2_PASSWORD="mude-esta-senha"
